<Window x:Class="Toolbox.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Toolbox.App" Title="卓盛工具箱" Width="1240" Height="840" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource WindowBackground}" Icon="/CZToolbox;component/toolbox.ico">
 <Grid Background="{DynamicResource WindowBackground}">
  <Grid x:Name="LoginPage">
   <StackPanel Width="420" VerticalAlignment="Center" Margin="0,-30,0,0">
    <Image Source="/CZToolbox;component/icons/toolbox-master.png" Width="86" Height="86" HorizontalAlignment="Center" Margin="0,0,0,18" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock Text="卓盛工具箱" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="让日常维护更简单" HorizontalAlignment="Center" Margin="0,10,0,26" Foreground="{DynamicResource TextMuted}" FontSize="16"/>
    <Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="30" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
     <StackPanel><TextBlock Text="访问验证" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="请输入访问密码。" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,18"/>
      <Grid Height="43"><PasswordBox x:Name="PasswordInput" PasswordChar="●" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" KeyDown="Password_KeyDown" AutomationProperties.Name="访问密码"/><TextBox x:Name="VisiblePassword" Visibility="Collapsed" KeyDown="Password_KeyDown" AutomationProperties.Name="显示密码"/></Grid>
      <CheckBox x:Name="ShowPassword" Content="显示密码" Margin="0,12,0,14" Checked="PasswordVisibility_Changed" Unchecked="PasswordVisibility_Changed"/>
      <TextBlock x:Name="LoginError" Foreground="{DynamicResource TextPrimary}" MinHeight="24" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
      <Button x:Name="UnlockButton" Content="登录" Style="{StaticResource Primary}" Margin="0" Click="Unlock_Click"/>
     </StackPanel>
    </Border>
    <TextBlock HorizontalAlignment="Center" Text="内部专用 · v1.0.0" Foreground="{DynamicResource TextMuted}" Margin="0,22,0,0"/>
    <TextBlock HorizontalAlignment="Center" Text="需要管理员权限" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,8,0,0"/>
   </StackPanel>
  </Grid>
  <Grid x:Name="Workspace" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"><Grid Margin="17,27,17,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="6,0,0,26"><Image Source="/CZToolbox;component/icons/toolbox-master.png" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,14" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="卓盛工具箱" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="日常维护 · 轻松有序" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Navigation">
     <Button AutomationProperties.Name="全部工具" Tag="" Style="{StaticResource Nav}" Click="Category_Click"><StackPanel Orientation="Horizontal"><local:ToolIcon Kind="grid" Foreground="{DynamicResource NavText}" Width="19" Height="19" Margin="0,0,12,0"/><TextBlock Text="全部工具" Foreground="{DynamicResource NavText}" VerticalAlignment="Center"/></StackPanel></Button>
     <Button AutomationProperties.Name="常用工具" Tag="常用工具" Style="{StaticResource Nav}" Click="Category_Click"><StackPanel Orientation="Horizontal"><local:ToolIcon Kind="tools" Foreground="{DynamicResource NavText}" Width="19" Height="19" Margin="0,0,12,0"/><TextBlock Text="常用工具" Foreground="{DynamicResource NavText}" VerticalAlignment="Center"/></StackPanel></Button>
     <Button AutomationProperties.Name="网络工具" Tag="网络工具" Style="{StaticResource Nav}" Click="Category_Click"><StackPanel Orientation="Horizontal"><local:ToolIcon Kind="network" Foreground="{DynamicResource NavText}" Width="19" Height="19" Margin="0,0,12,0"/><TextBlock Text="网络工具" Foreground="{DynamicResource NavText}" VerticalAlignment="Center"/></StackPanel></Button>
     <Button AutomationProperties.Name="磁盘工具" Tag="磁盘工具" Style="{StaticResource Nav}" Click="Category_Click"><StackPanel Orientation="Horizontal"><local:ToolIcon Kind="disk" Foreground="{DynamicResource NavText}" Width="19" Height="19" Margin="0,0,12,0"/><TextBlock Text="磁盘工具" Foreground="{DynamicResource NavText}" VerticalAlignment="Center"/></StackPanel></Button>
     <Button AutomationProperties.Name="重装维护" Tag="重装维护" Style="{StaticResource Nav}" Click="Category_Click"><StackPanel Orientation="Horizontal"><local:ToolIcon Kind="restore" Foreground="{DynamicResource NavText}" Width="19" Height="19" Margin="0,0,12,0"/><TextBlock Text="重装维护" Foreground="{DynamicResource NavText}" VerticalAlignment="Center"/></StackPanel></Button>
     <Button AutomationProperties.Name="系统设置" Tag="系统设置" Style="{StaticResource Nav}" Click="Category_Click"><StackPanel Orientation="Horizontal"><local:ToolIcon Kind="settings" Foreground="{DynamicResource NavText}" Width="19" Height="19" Margin="0,0,12,0"/><TextBlock Text="系统设置" Foreground="{DynamicResource NavText}" VerticalAlignment="Center"/></StackPanel></Button>
     <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,19,0,14"/>
     <Button AutomationProperties.Name="使用说明" Style="{StaticResource Nav}" Click="Help_Click"><StackPanel Orientation="Horizontal"><local:ToolIcon Kind="help" Foreground="{DynamicResource NavText}" Width="19" Height="19" Margin="0,0,12,0"/><TextBlock Text="使用说明" Foreground="{DynamicResource NavText}" VerticalAlignment="Center"/></StackPanel></Button>
     <Button AutomationProperties.Name="软件更新" Style="{StaticResource Nav}" Click="Updates_Click"><StackPanel Orientation="Horizontal"><local:ToolIcon Kind="update" Foreground="{DynamicResource NavText}" Width="19" Height="19" Margin="0,0,12,0"/><TextBlock Text="软件更新" Foreground="{DynamicResource NavText}" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2"><TextBlock x:Name="AdminStatus" Text="管理员状态由系统检查" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,8"/><TextBlock Text="v1.0.0 · 内部使用" Foreground="{DynamicResource TextMuted}" FontSize="12"/><Button AutomationProperties.Name="锁定工具箱" Style="{StaticResource Nav}" Margin="0,12,0,0" Click="Lock_Click"><StackPanel Orientation="Horizontal"><local:ToolIcon Kind="lock" Foreground="{DynamicResource NavText}" Width="19" Height="19" Margin="0,0,12,0"/><TextBlock Text="锁定工具箱" Foreground="{DynamicResource NavText}" VerticalAlignment="Center"/></StackPanel></Button></StackPanel>
   </Grid></Border>
   <Grid Grid.Column="1" Margin="26,66,26,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="245"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="全部工具" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="找到需要的工具，查看说明后再打开。" Foreground="{DynamicResource TextMuted}" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="搜索名称或用途" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,5"/><Grid><TextBox x:Name="SearchInput" Padding="36,10,12,10" TextChanged="Search_Changed" AutomationProperties.Name="搜索工具"/><local:ToolIcon Kind="search" Width="17" Height="17" HorizontalAlignment="Left" Margin="12,0,0,0" Foreground="{DynamicResource TextMuted}"/></Grid></StackPanel></Grid>
    <Border Grid.Row="1" Background="{DynamicResource Subtle}" CornerRadius="7" Padding="12,10" Margin="0,20,0,18"><StackPanel Orientation="Horizontal"><local:ToolIcon Kind="shield" Width="16" Height="16" Margin="0,0,9,0" Foreground="{DynamicResource TextMuted}"/><TextBlock x:Name="Notice" Text="工具启动前校验文件完整性。系统变更操作需单独确认。" Foreground="{DynamicResource TextMuted}" FontSize="12"/></StackPanel></Border>
    <Grid Grid.Row="2" x:Name="ToolsPage">
     <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="ToolCount" Margin="16,14" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
      <ListBox x:Name="ToolList" Grid.Row="1" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" Background="Transparent" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Tool_Changed" HorizontalContentAlignment="Stretch" Margin="6,0,6,8" AutomationProperties.Name="工具列表">
       <ListBox.ItemTemplate><DataTemplate><Grid Margin="10,13"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource IconBackground}" CornerRadius="10" Width="36" Height="36" VerticalAlignment="Top"><local:ToolIcon Kind="{Binding Id,Converter={StaticResource ToolIconConverter}}"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,5,0,9" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextMuted}"/><TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource TextMuted}"/><TextBlock Text="{Binding Risk}" FontSize="10" Foreground="{DynamicResource TextMuted}"/></StackPanel></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid></Border>
     <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="DetailContent" Margin="24,23,24,20"><Border Background="{DynamicResource IconBackground}" CornerRadius="14" Width="58" Height="58" HorizontalAlignment="Left" Margin="0,0,0,18"><local:ToolIcon x:Name="DetailIcon" Width="30" Height="30"/></Border><TextBlock x:Name="DetailName" FontSize="23" FontWeight="SemiBold" Text="请选择一个工具"/><TextBlock x:Name="DetailMeta" Foreground="{DynamicResource TextMuted}" Margin="0,9,0,20" FontSize="12"/>
       <StackPanel x:Name="DetailSections"><TextBlock Text="功能说明" FontWeight="Bold"/><TextBlock x:Name="DetailPurpose" Margin="0,8,0,18" LineHeight="23"/>
       <TextBlock Text="操作准备" FontWeight="Bold"/><TextBlock x:Name="DetailPreparation" Margin="0,8,0,18" LineHeight="23"/>
       <TextBlock Text="操作步骤" FontWeight="Bold"/><TextBlock x:Name="DetailSteps" Margin="0,8,0,18" LineHeight="25"/>
       <Border Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,18"><StackPanel><StackPanel Orientation="Horizontal"><local:ToolIcon Kind="warning" Foreground="{DynamicResource WarningText}" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="影响与注意事项" Foreground="{DynamicResource WarningText}" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="DetailImpact" Foreground="{DynamicResource WarningText}" Margin="0,7,0,8" LineHeight="23"/><TextBlock x:Name="DetailRestart" Foreground="{DynamicResource WarningText}" FontSize="12"/></StackPanel></Border>
       <TextBlock Text="结果验证" FontWeight="Bold"/><TextBlock x:Name="DetailResult" Margin="0,8,0,18" LineHeight="23"/>
       <TextBlock x:Name="DetailEvidence" Foreground="{DynamicResource TextMuted}" FontSize="12" LineHeight="21"/></StackPanel>
      </StackPanel></ScrollViewer>
      <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="校验原文件后打开" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"/><Button x:Name="LaunchButton" Grid.Column="1" Content="打开工具" Style="{StaticResource Primary}" Margin="10,0,0,0" IsEnabled="False" Click="Launch_Click"/></Grid></Border>
     </Grid></Border>
    </Grid>
    <ScrollViewer Grid.Row="2" x:Name="HelpPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><Border Background="{DynamicResource Surface}" CornerRadius="14" Padding="27"><StackPanel>
     <TextBlock Text="使用流程" FontSize="21" FontWeight="Bold"/><TextBlock Margin="0,15,0,22" LineHeight="27" Text="1. 在左侧选择分类，或搜索工具的名称与用途。&#10;2. 选中一个工具，先读右侧的准备、步骤和影响说明。&#10;3. 点击“打开工具”。高影响工具会再次确认。&#10;4. 在第三方工具内按它的提示操作，自行核对结果。"/>
     <TextBlock Text="管理员与 UAC" FontWeight="Bold" FontSize="17"/><TextBlock Margin="0,10,0,22" LineHeight="25" Text="工具箱每次运行都申请管理员权限。Windows 的管理员确认提示属于正常流程，拒绝授权则无法进入。工具箱不要求关闭 UAC。&#10;&#10;“关闭 UAC 提示”是单独的高影响工具，会导入注册表并可能需要重启；它与工具箱申请管理员权限是两件事。"/>
     <TextBlock Text="浏览器清理与未接入内容" FontWeight="Bold" FontSize="17"/><TextBlock Margin="0,10,0,22" LineHeight="25" Text="浏览器配置与推广清理已按原 BAT 完整封装，入口位于“重装维护”。它会删除用户配置和收藏夹，深度模式还会删除程序目录与注册表；原脚本没有自动备份，请提前手工备份并阅读完整影响说明。PE 和静默调用保留原行为及其限制。&#10;&#10;电脑信息查询暂不制作，后续结合其他项目接入。EncryptSynaptics.com 用途未确认，仍不开放。"/>
     <TextBlock Text="密码、第三方工具与状态" FontWeight="Bold" FontSize="17"/><TextBlock Margin="0,10,0,22" LineHeight="25" Text="入口使用共享口令，每次打开都需输入；它适合作为内部使用门槛，不能防止软件被复制或第三方工具被单独提取。&#10;&#10;原第三方工具可能有自己的提示、安装流程或密码，例如天喵工具的原文件名标注为 1788。工具箱的口令不会替代它们。&#10;&#10;“已启动”仅代表程序打开，不代表维修、重装、激活或设置修改完成。未实测的行为会明确标注。"/>
     <TextBlock Text="自动更新与日志" FontWeight="Bold" FontSize="17"/><TextBlock Margin="0,10,0,10" LineHeight="25" Text="解锁后检查更新，断网不影响继续使用。发现新版后，展示说明，由你选择下载安装；下载完成并校验通过才会运行安装程序。请先关闭由工具箱打开的工具。&#10;&#10;更新地址未配置时会明确提示。Windows 更新设置工具只针对系统更新，不会关闭工具箱更新。&#10;&#10;本地日志只记录时间、版本和工具启动错误，不记录入口口令。"/>
     <Button Content="打开日志文件夹" HorizontalAlignment="Left" Click="Logs_Click" Margin="0,10,0,0"/>
    </StackPanel></Border></ScrollViewer>
    <ScrollViewer Grid.Row="2" x:Name="UpdatePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><Border Background="{DynamicResource Surface}" CornerRadius="14" Padding="28"><StackPanel>
     <TextBlock Text="版本更新" FontSize="22" FontWeight="Bold"/><TextBlock Text="当前版本 1.0.0" Foreground="{DynamicResource TextMuted}" Margin="0,12,0,25"/>
     <TextBlock x:Name="UpdateStatus" Text="解锁后将自动检查更新。" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="UpdateNotes" LineHeight="25" Margin="0,16,0,20"/>
     <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="8" Visibility="Collapsed" Margin="0,0,0,18"/>
     <StackPanel Orientation="Horizontal"><Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click"/><Button x:Name="InstallUpdateButton" Content="下载并安装新版" Style="{StaticResource Primary}" Visibility="Collapsed" Click="InstallUpdate_Click"/><Button x:Name="CancelUpdateButton" Content="取消下载" Visibility="Collapsed" Click="CancelUpdate_Click"/></StackPanel>
     <Border Background="{DynamicResource Subtle}" CornerRadius="7" Padding="16" Margin="0,28,0,0"><TextBlock Text="更新包会校验发布签名、文件大小和 SHA-256。校验失败不会安装。&#10;安装前请保存工作、关闭已打开的工具；工具箱会退出，安装完成后可重新打开。" Foreground="{DynamicResource TextMuted}" LineHeight="24"/></Border>
    </StackPanel></Border></ScrollViewer>
    <TextBlock Grid.Row="3" x:Name="StatusText" Text="就绪" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,13,0,0" AutomationProperties.LiveSetting="Polite"/>
   </Grid>
  </Grid>
  <ComboBox x:Name="ThemePicker" Panel.ZIndex="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,26,0" Width="112" SelectionChanged="Theme_Changed" AutomationProperties.Name="界面主题"><ComboBoxItem Content="跟随系统" Tag="system"/><ComboBoxItem Content="浅色" Tag="light"/><ComboBoxItem Content="深色" Tag="dark"/></ComboBox>
 </Grid>
</Window>
